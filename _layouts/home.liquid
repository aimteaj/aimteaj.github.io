---
layout: default
---
{% assign m = site.data.mentorship %}
<div class="hm">

  <!-- Header -->
  <header class="hm-head">
    <div class="hm-photo">
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="260px" alt="Ahmed Imteaj" cache_bust=true %}
    </div>
    <div class="hm-id">
      <h1 class="hm-name">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hm-role">Assistant Professor of Electrical Engineering and Computer Science<br><a href="https://www.fau.edu/" target="_blank" rel="noopener">Florida Atlantic University</a>, Boca Raton</p>
      <ul class="hm-aff">
        <li>Founding Director, <a href="https://www.speedlab.network" target="_blank" rel="noopener">SPEED Lab</a></li>
        <li>Faculty Fellow, <a href="https://www.fau.edu/smart/leadership/" target="_blank" rel="noopener">I-SMART</a></li>
        <li>Senior Member, <a href="https://www.fau.edu/engineering/research/c2a2/people/" target="_blank" rel="noopener">CA-AI</a></li>
      </ul>
      <nav class="hm-links" aria-label="Contact and profiles">
        <a href="mailto:aimteaj@fau.edu"><i class="fa-solid fa-envelope" aria-hidden="true"></i>Email</a>
        <a href="https://scholar.google.com/citations?user=I5IZ4GQAAAAJ" target="_blank" rel="noopener"><i class="ai ai-google-scholar" aria-hidden="true"></i>Google Scholar</a>
        <a href="https://www.linkedin.com/in/ahmed-imteaj-a13343a3" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin" aria-hidden="true"></i>LinkedIn</a>
        <a href="https://orcid.org/0000-0002-6975-3997" target="_blank" rel="noopener"><i class="ai ai-orcid" aria-hidden="true"></i>ORCID</a>
      </nav>
    </div>
  </header>

  <div class="hm-bio">{{ content }}</div>

  <!-- 2026 highlights -->
  {% assign hl = site.data.highlights_2026 %}
  {% assign n_conf = hl | where: "kind", "conference" | size %}
  {% assign n_jour = hl | where: "kind", "journal" | size %}
  {% assign n_pre = hl | where: "kind", "preprint" | size %}
  <section class="hm-sec hm-hl">
    <div class="hm-hl-bar">
      <h2 class="hm-h2">2026 at top AI venues</h2>
      <div class="hm-hl-seg" role="group" aria-label="Filter 2026 papers by type">
        <button class="is-on" data-k="all" aria-pressed="true">All <b>{{ hl.size }}</b></button>
        <button data-k="conference" aria-pressed="false">Conferences <b>{{ n_conf }}</b></button>
        <button data-k="journal" aria-pressed="false">Journals <b>{{ n_jour }}</b></button>
        {% if n_pre > 0 %}<button data-k="preprint" aria-pressed="false">Preprints <b>{{ n_pre }}</b></button>{% endif %}
      </div>
    </div>

    <div class="hm-hl-wrap">
      <ol class="hm-hl-list" role="tablist" aria-orientation="vertical" aria-label="2026 papers">
        {% for h in hl %}
        <li role="presentation" data-k="{{ h.kind }}">
          <button class="hm-hl-item{% if forloop.first %} is-on{% endif %}" role="tab" id="hl-tab-{{ forloop.index0 }}" aria-controls="hl-panel" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-i="{{ forloop.index0 }}">
            <span class="hm-hl-v">{{ h.venue }}</span>
            <span class="hm-hl-t">{{ h.title }}</span>
          </button>
        </li>
        {% endfor %}
      </ol>

      {% assign f = hl[0] %}
      <article class="hm-hl-panel" id="hl-panel" role="tabpanel" aria-labelledby="hl-tab-0" aria-live="polite">
        <a class="hm-hl-img" href="{{ '/publications/' | relative_url }}#{{ f.key }}" tabindex="-1" aria-hidden="true">
          <img src="{{ '/assets/img/publication_preview/' | append: f.image | relative_url }}" alt="" loading="lazy">
        </a>
        <div class="hm-hl-body">
          <div class="hm-hl-tags"><span class="hm-hl-venue">{{ f.venue }}</span><span class="hm-hl-track">{{ f.track }}</span><span class="hm-hl-rank"{% if f.rank == "" %} hidden{% endif %}>{{ f.rank }}</span></div>
          <h3 class="hm-hl-title">{{ f.title }}</h3>
          <p class="hm-hl-authors">{{ f.authors }}</p>
          <dl class="hm-hl-facts">
            <div><dt>Where</dt><dd class="hm-hl-where">{{ f.where }}</dd></div>
            <div><dt>When</dt><dd class="hm-hl-when">{{ f.when }}</dd></div>
          </dl>
          <div class="hm-hl-nav">
            <a class="hm-hl-go" href="{{ '/publications/' | relative_url }}#{{ f.key }}">View publication</a>
            <span class="hm-hl-pos"><button class="hm-hl-prev" type="button" aria-label="Previous paper"></button><span class="hm-hl-count">1 / {{ hl.size }}</span><button class="hm-hl-next" type="button" aria-label="Next paper"></button></span>
          </div>
        </div>
      </article>
    </div>
    <script type="application/json" id="hl-data">{{ hl | jsonify }}</script>
  </section>

  <!-- Research interests explorer -->
  <section class="hm-sec">
    <h2 class="hm-h2">Research</h2>
    <div class="hm-explore">
      <div class="hm-topics" role="tablist" aria-label="Research interests">
        <button class="hm-topic is-on" role="tab" aria-selected="true" data-sel="1">Selected publications</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="vision-language|vlm|lvlm|multimodal|clip|language model|llm">Vision-language models and multimodal LLMs</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="federated">Federated learning for edge devices</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="secur|privacy|trust|attack|poison|jailbreak|intrusion|exploit">Trustworthy AI, agentic AI and cybersecurity</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="robust|adversarial|hallucinat">Robustness of VLMs and FL</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="quantum">Quantum AI and post-quantum security</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="image|video|uav|drone|pose|skeleton|land cover|chart|scene">Computer vision, 3D models and digital twins</button>
        <button class="hm-topic" role="tab" aria-selected="false" data-re="vehicle|driver|road|traffic|medical|health|wearable|stress|crime|surveillance|power|disaster|land cover">Applications: transportation, health, surveillance, infrastructure</button>
      </div>
      <div class="hm-papers" role="tabpanel" aria-live="polite">
        <div class="hm-plist">{% bibliography --template bib_mini --group_by none %}</div>
        <p class="hm-pnone" hidden>Ongoing work in the SPEED Lab. Publications in this area are on the way.</p>
        <a class="hm-pall" href="{{ '/publications/' | relative_url }}">See all publications</a>
      </div>
    </div>
  </section>

  <!-- Research support -->
  <section class="hm-sec">
    <h2 class="hm-h2">Research support</h2>
    <div class="hm-sponsors">
      {% for sp in site.data.sponsors %}
      <a class="hm-sp" href="{{ '/grants-awards/' | relative_url }}" aria-label="{{ sp.name }}: {{ sp.funds }}">
        <span class="hm-sp-logo"><img src="{{ '/assets/img/sponsors/' | append: sp.logo | relative_url }}" alt="{{ sp.name }}" loading="lazy"></span>
        <span class="hm-sp-cap"><strong>{{ sp.name }}</strong>{{ sp.funds }}</span>
      </a>
      {% endfor %}
    </div>
  </section>

  <!-- News -->
  {% assign news = site.news | reverse %}
  <section class="hm-sec">
    <h2 class="hm-h2">News</h2>
    <div class="hm-nf" role="group" aria-label="Filter news">
      <button class="hm-nfb is-on" data-c="all" aria-pressed="true">All <span></span></button>
      <button class="hm-nfb" data-c="paper" aria-pressed="false">Papers <span></span></button>
      <button class="hm-nfb" data-c="grant" aria-pressed="false">Grants and awards <span></span></button>
      <button class="hm-nfb" data-c="talk" aria-pressed="false">Talks and media <span></span></button>
      <button class="hm-nfb" data-c="service" aria-pressed="false">Service <span></span></button>
    </div>
    <div class="hm-tl">
      {% for item in news %}
      {% assign y = item.date | date: '%Y' %}
      <article class="hm-ni" data-year="{{ y }}">
        <button class="hm-nh" type="button" aria-expanded="false">
          <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %d' }}</time>
          <span class="hm-ncat"></span>
          <span class="hm-nt"></span>
          <span class="hm-nchev" aria-hidden="true"></span>
        </button>
        <div class="hm-nc" hidden>{% if item.inline %}{{ item.content | emojify }}{% else %}<a href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}</div>
      </article>
      {% endfor %}
    </div>
    <button class="hm-more" type="button" hidden></button>
  </section>
</div>

<style>
.hm [hidden] { display: none !important; }
.hm { max-width: 980px; margin: 0 auto; }
.hm a { text-decoration: none; }

.hm-head { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 2.4rem; align-items: start; padding-top: 0.5rem; }
.hm-photo img { width: 100%; border-radius: 8px; display: block; }
.hm-name { font-size: 2.6rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.6rem; color: var(--global-text-color); }
.hm-role { font-size: 1.05rem; line-height: 1.5; margin: 0 0 0.9rem; color: var(--global-text-color); }
.hm-role a, .hm-aff a { color: var(--global-theme-color); font-weight: 600; }
.hm-aff { list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: 0.95rem; color: var(--global-text-color-light); line-height: 1.7; }
.hm-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.hm-links a { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.88rem; font-weight: 600; padding: 0.42rem 0.85rem; border: 1px solid var(--global-divider-color); border-radius: 6px; color: var(--global-text-color); transition: border-color 0.15s ease, color 0.15s ease; }
.hm-links a:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }
.hm-links i { font-size: 1rem; }
.hm-links a:focus-visible, .hm-fact:focus-visible, .hm-topic:focus-visible, .hm-more:focus-visible, .hm-paper:focus-visible { outline: 2px solid var(--global-theme-color); outline-offset: 2px; }

.hm-bio { margin-top: 2rem; font-size: 1.02rem; line-height: 1.75; color: var(--global-text-color); max-width: 74ch; }
.hm-bio p { margin-bottom: 1rem; }
.hm-bio a { color: var(--global-theme-color); font-weight: 600; }

.hm-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); margin-top: 1.8rem; }
.hm-fact { display: flex; flex-direction: column; gap: 0.2rem; padding: 1.1rem 1rem 1rem; border-right: 1px solid var(--global-divider-color); position: relative; }
.hm-fact:last-child { border-right: 0; }
.hm-fn { font-size: 2rem; font-weight: 700; line-height: 1.1; color: var(--global-text-color); font-variant-numeric: tabular-nums; }
.hm-fl { font-size: 0.86rem; font-weight: 600; color: var(--global-text-color-light); line-height: 1.35; }
.hm-fact::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--global-theme-color); transform: scaleX(0); transform-origin: left; transition: transform 0.2s ease; }
.hm-fact:hover::after { transform: scaleX(1); }
.hm-fact:hover .hm-fn { color: var(--global-theme-color); }

.hm-sec { padding-top: 2.6rem; }
.hm-h2 { font-size: 1.35rem; font-weight: 700; margin: 0 0 1.1rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--global-text-color); }

.hm-explore { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 2rem; align-items: start; }
.hm-topics { display: flex; flex-direction: column; border-left: 1px solid var(--global-divider-color); }
.hm-topic { all: unset; cursor: pointer; padding: 0.6rem 0 0.6rem 1rem; margin-left: -1px; border-left: 3px solid transparent; font-size: 0.95rem; font-weight: 600; line-height: 1.35; color: var(--global-text-color-light); }
.hm-topic:hover { color: var(--global-text-color); }
.hm-topic.is-on { color: var(--global-theme-color); border-left-color: var(--global-theme-color); }
.hm-plist { display: flex; flex-direction: column; }
.hm-plist ol, .hm-plist ul { list-style: none; padding: 0; margin: 0; }
.hm-plist li { margin: 0; padding: 0; }
.hm-plist h2 { display: none; }
.hm-paper { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--global-divider-color); color: var(--global-text-color); }
.hm-paper:hover .hm-pt { color: var(--global-theme-color); }
.hm-pv { font-size: 0.78rem; font-weight: 700; color: var(--global-theme-color); padding-top: 0.15rem; font-variant-numeric: tabular-nums; }
.hm-pt { font-size: 0.95rem; line-height: 1.45; font-weight: 500; }
.hm-pnone { color: var(--global-text-color-light); padding: 0.8rem 0; }
.hm-pall { display: inline-block; margin-top: 0.9rem; font-size: 0.9rem; font-weight: 600; color: var(--global-theme-color) !important; text-decoration: underline !important; text-underline-offset: 3px; }

/* 2026 highlights: list + featured panel */
.hm-hl-bar { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.6rem 1rem; border-bottom: 1px solid var(--global-text-color); margin-bottom: 1.2rem; }
.hm-hl-bar .hm-h2 { border: 0; margin: 0; padding-bottom: 0.7rem; }
.hm-hl-seg { display: inline-flex; margin-bottom: 0.6rem; border: 1px solid var(--global-divider-color); border-radius: 8px; padding: 3px; gap: 2px; }
.hm-hl-seg button { all: unset; cursor: pointer; font-size: 0.84rem; font-weight: 600; padding: 0.35rem 0.75rem; border-radius: 6px; color: var(--global-text-color-light); }
.hm-hl-seg button b { font-weight: 700; margin-left: 0.25rem; font-variant-numeric: tabular-nums; color: var(--global-text-color); }
.hm-hl-seg button:hover { color: var(--global-text-color); }
.hm-hl-seg button.is-on { background: var(--global-text-color); color: var(--global-bg-color); }
.hm-hl-seg button.is-on b { color: var(--global-bg-color); }

.hm-hl-wrap { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr); gap: 1.8rem; align-items: start; }
.hm-hl-list { list-style: none; margin: 0; padding: 0; max-height: 560px; overflow-y: auto; border-left: 1px solid var(--global-divider-color); scrollbar-width: thin; }
.hm-hl-list li { margin: 0; }
.hm-hl-item { all: unset; box-sizing: border-box; cursor: pointer; display: block; width: 100%; padding: 0.7rem 0.9rem 0.7rem 1rem; margin-left: -1px; border-left: 3px solid transparent; }
.hm-hl-item:hover { background: rgba(127,127,127,0.06); }
.hm-hl-item.is-on { border-left-color: var(--global-theme-color); background: rgba(127,127,127,0.08); }
.hm-hl-item:focus-visible { outline: 2px solid var(--global-theme-color); outline-offset: -2px; }
.hm-hl-v { display: block; font-size: 0.76rem; font-weight: 700; color: var(--global-text-color-light); font-variant-numeric: tabular-nums; margin-bottom: 0.15rem; }
.hm-hl-item.is-on .hm-hl-v { color: var(--global-theme-color); }
.hm-hl-t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.9rem; font-weight: 600; line-height: 1.4; color: var(--global-text-color); }

.hm-hl-panel { position: sticky; top: 76px; border: 1px solid var(--global-divider-color); border-radius: 10px; overflow: hidden; background: var(--global-card-bg-color); }
.hm-hl-img { display: block; aspect-ratio: 16 / 9; background: #0b1020; overflow: hidden; }
.hm-hl-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.25s ease; }
.hm-hl-panel.is-swapping .hm-hl-img img, .hm-hl-panel.is-swapping .hm-hl-body { opacity: 0; }
.hm-hl-body { padding: 1.1rem 1.3rem 1.2rem; transition: opacity 0.2s ease; }
.hm-hl-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-bottom: 0.6rem; }
.hm-hl-venue { font-weight: 800; font-size: 1.02rem; color: var(--global-text-color); margin-right: 0.2rem; }
.hm-hl-track, .hm-hl-rank { font-size: 0.74rem; font-weight: 700; padding: 0.12rem 0.5rem; border-radius: 4px; border: 1px solid var(--global-divider-color); color: var(--global-text-color-light); }
.hm-hl-rank { border-color: var(--global-theme-color); color: var(--global-theme-color); }
.hm-hl-title { font-size: 1.12rem; font-weight: 700; line-height: 1.4; margin: 0 0 0.45rem; color: var(--global-text-color); }
.hm-hl-authors { font-size: 0.9rem; color: var(--global-text-color-light); margin: 0 0 0.9rem; line-height: 1.5; }
.hm-hl-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin: 0 0 1rem; padding: 0.75rem 0; border-top: 1px solid var(--global-divider-color); border-bottom: 1px solid var(--global-divider-color); }
.hm-hl-facts dt { font-size: 0.74rem; font-weight: 700; color: var(--global-text-color-light); margin: 0; }
.hm-hl-facts dd { font-size: 0.9rem; margin: 0.1rem 0 0; color: var(--global-text-color); line-height: 1.4; }
.hm-hl-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.hm-hl-go { font-size: 0.9rem; font-weight: 700; color: #fff !important; background: var(--global-theme-color); padding: 0.5rem 1rem; border-radius: 6px; }
.hm-hl-go:hover { filter: brightness(1.08); }
.hm-hl-go:focus-visible, .hm-hl-pos button:focus-visible, .hm-hl-seg button:focus-visible { outline: 2px solid var(--global-theme-color); outline-offset: 2px; }
.hm-hl-pos { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--global-text-color-light); font-variant-numeric: tabular-nums; }
.hm-hl-pos button { all: unset; cursor: pointer; width: 30px; height: 30px; border: 1px solid var(--global-divider-color); border-radius: 50%; display: grid; place-items: center; }
.hm-hl-pos button:hover { border-color: var(--global-theme-color); }
.hm-hl-pos button::before { content: ""; width: 7px; height: 7px; border-left: 2px solid var(--global-text-color); border-bottom: 2px solid var(--global-text-color); transform: translateX(1px) rotate(45deg); }
.hm-hl-next::before { transform: translateX(-1px) rotate(-135deg) !important; }

/* Research support: logo wall; hover or focus shows what each sponsor funds */
.hm-sponsors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
.hm-sp { position: relative; display: block; height: 116px; border-radius: 8px; overflow: hidden; background: #fff; border: 1px solid var(--global-divider-color); }
.hm-sp-logo { position: absolute; inset: 0; display: grid; place-items: center; padding: 1.1rem 1.4rem; transition: opacity 0.2s ease, transform 0.25s ease; }
.hm-sp-logo img { max-width: 100%; max-height: 72px; object-fit: contain; }
.hm-sp-cap { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 0.25rem; padding: 0.9rem 1.1rem; background: var(--global-theme-color); color: #fff; font-size: 0.88rem; line-height: 1.4; opacity: 0; transform: translateY(8px); transition: opacity 0.2s ease, transform 0.25s ease; }
.hm-sp-cap strong { font-size: 0.95rem; }
.hm-sp:hover .hm-sp-cap, .hm-sp:focus-visible .hm-sp-cap { opacity: 1; transform: none; }
.hm-sp:hover .hm-sp-logo, .hm-sp:focus-visible .hm-sp-logo { opacity: 0; transform: scale(0.96); }
.hm-sp:focus-visible { outline: 2px solid var(--global-theme-color); outline-offset: 2px; }

/* News */
.hm-nf { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.2rem; }
.hm-nfb { all: unset; cursor: pointer; font-size: 0.88rem; font-weight: 600; padding: 0.35rem 0.8rem; border: 1px solid var(--global-divider-color); border-radius: 999px; color: var(--global-text-color); }
.hm-nfb span { font-weight: 700; color: var(--global-text-color-light); margin-left: 0.2rem; font-variant-numeric: tabular-nums; }
.hm-nfb:hover { border-color: var(--global-theme-color); }
.hm-nfb.is-on { background: var(--global-theme-color); border-color: var(--global-theme-color); color: #fff; }
.hm-nfb.is-on span { color: rgba(255,255,255,0.8); }
.hm-nfb:focus-visible, .hm-nh:focus-visible { outline: 2px solid var(--global-theme-color); outline-offset: 2px; }

.hm-tl { position: relative; padding-left: 26px; }
.hm-tl::before { content: ""; position: absolute; left: 5px; top: 0.6rem; bottom: 0.6rem; width: 2px; background: var(--global-divider-color); }
.hm-yr { position: relative; font-size: 1rem; font-weight: 700; margin: 1.2rem 0 0.3rem; color: var(--global-text-color); }
.hm-yr:first-child { margin-top: 0; }
.hm-yr::before { content: ""; position: absolute; left: -26px; top: 0.3rem; width: 12px; height: 12px; border-radius: 50%; background: var(--global-text-color); }
.hm-ni { position: relative; border-bottom: 1px solid var(--global-divider-color); }
.hm-ni::before { content: ""; position: absolute; left: -26px; top: 1.05rem; width: 8px; height: 8px; border-radius: 50%; background: var(--global-bg-color); border: 2px solid var(--global-text-color-light); }
.hm-ni.is-open::before { background: var(--global-theme-color); border-color: var(--global-theme-color); }
.hm-nh { all: unset; cursor: pointer; display: grid; grid-template-columns: 58px auto minmax(0, 1fr) 16px; gap: 0.8rem; align-items: baseline; width: 100%; padding: 0.8rem 0; box-sizing: border-box; }
.hm-nh time { font-size: 0.82rem; font-weight: 700; color: var(--global-text-color-light); font-variant-numeric: tabular-nums; }
.hm-ncat { font-size: 0.72rem; font-weight: 700; padding: 0.08rem 0.45rem; border-radius: 4px; white-space: nowrap; border: 1px solid currentColor; }
.hm-ncat[data-c="paper"] { color: #2563eb; } .hm-ncat[data-c="grant"] { color: #b45309; } .hm-ncat[data-c="talk"] { color: #0f766e; } .hm-ncat[data-c="service"] { color: #7c3aed; } .hm-ncat[data-c="update"] { color: var(--global-text-color-light); }
html[data-theme="dark"] .hm-ncat[data-c="paper"] { color: #93c5fd; } html[data-theme="dark"] .hm-ncat[data-c="grant"] { color: #fcd34d; } html[data-theme="dark"] .hm-ncat[data-c="talk"] { color: #5eead4; } html[data-theme="dark"] .hm-ncat[data-c="service"] { color: #c4b5fd; }
.hm-nt { font-size: 0.97rem; font-weight: 600; line-height: 1.45; color: var(--global-text-color); }
.hm-nh:hover .hm-nt { color: var(--global-theme-color); }
.hm-nchev { width: 8px; height: 8px; border-right: 2px solid var(--global-text-color-light); border-bottom: 2px solid var(--global-text-color-light); transform: rotate(45deg); transition: transform 0.2s ease; align-self: center; }
.hm-ni.is-open .hm-nchev { transform: rotate(-135deg); }
.hm-nc { padding: 0 0 1rem 71px; font-size: 0.94rem; line-height: 1.65; color: var(--global-text-color); max-width: 78ch; }
.hm-nc [style] { background: none !important; border: 0 !important; padding: 0 !important; box-shadow: none !important; border-radius: 0 !important; font-size: inherit !important; }
.hm-nc span[style], .hm-nc strong[style] { color: inherit !important; }
.hm-nc br + br { display: none; }
.hm-nc p { margin: 0 0 0.6rem; }
.hm-nc p:last-child { margin-bottom: 0; }
.hm-nc a { color: var(--global-theme-color); font-weight: 600; }
.hm-nc a span[style] { color: inherit !important; }
.hm-more { all: unset; cursor: pointer; margin-top: 1rem; font-size: 0.9rem; font-weight: 600; color: var(--global-theme-color); padding: 0.45rem 0.9rem; border: 1px solid var(--global-theme-color); border-radius: 6px; }
.hm-more:hover { background: var(--global-theme-color); color: #fff; }

@media (max-width: 760px) {
  .hm-head { grid-template-columns: 1fr; gap: 1.2rem; }
  .hm-photo { max-width: 200px; }
  .hm-name { font-size: 2.1rem; }
  .hm-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hm-fact:nth-child(2n) { border-right: 0; }
  .hm-fact:nth-child(-n+2) { border-bottom: 1px solid var(--global-divider-color); }
  .hm-explore { grid-template-columns: 1fr; gap: 1rem; }
  .hm-topics { flex-direction: row; overflow-x: auto; border-left: 0; border-bottom: 1px solid var(--global-divider-color); gap: 0.2rem; scrollbar-width: thin; }
  .hm-topic { white-space: nowrap; padding: 0.55rem 0.8rem; margin: 0 0 -1px; border-left: 0; border-bottom: 3px solid transparent; }
  .hm-topic.is-on { border-bottom-color: var(--global-theme-color); }
  .hm-paper { grid-template-columns: 76px minmax(0, 1fr); gap: 0.7rem; }
  .hm-sponsors { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hm-hl-wrap { grid-template-columns: 1fr; gap: 1rem; }
  .hm-hl-panel { position: static; order: -1; }
  .hm-hl-list { max-height: 320px; }
  .hm-hl-bar { align-items: flex-start; }
  .hm-hl-seg { flex-wrap: wrap; }
  .hm-sp { height: 96px; }
  .hm-nh { grid-template-columns: 50px minmax(0, 1fr) 14px; row-gap: 0.3rem; }
  .hm-ncat { grid-column: 2; justify-self: start; }
  .hm-nt { grid-column: 2; }
  .hm-nchev { grid-column: 3; grid-row: 1; }
  .hm-nc { padding-left: 0; }
}
@media (prefers-reduced-motion: reduce) { .hm-hl-img img, .hm-hl-body, .hm-links a, .hm-sp-logo, .hm-sp-cap, .hm-nchev { transition: none; } }
</style>

<script>
(function () {
  var root = document.querySelector('.hm'); if (!root) return;
  var papers = Array.prototype.slice.call(root.querySelectorAll('.hm-paper'));
  var none = root.querySelector('.hm-pnone'), topics = root.querySelectorAll('.hm-topic');
  function show(btn) {
    topics.forEach(function (t) { var on = t === btn; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', on); });
    var re = btn.dataset.re ? new RegExp(btn.dataset.re, 'i') : null, n = 0, cap = 8;
    papers.forEach(function (p) {
      var hit = re ? re.test(p.dataset.text) : p.dataset.sel === '1';
      var vis = hit && n < cap; if (vis) n++;
      (p.closest('li') || p).hidden = !vis;
    });
    none.hidden = n > 0;
  }
  topics.forEach(function (t) { t.addEventListener('click', function () { show(t); }); });
  if (topics.length) show(topics[0]);

  // ---- 2026 highlights: pick a paper from the list to feature it
  (function () {
    var dataEl = root.querySelector('#hl-data'); if (!dataEl) return;
    var data = JSON.parse(dataEl.textContent), base = root.querySelector('.hm-hl-go').getAttribute('href').split('#')[0];
    var imgBase = root.querySelector('.hm-hl-img img').getAttribute('src').replace(/[^/]*$/, '');
    var panel = root.querySelector('.hm-hl-panel'), tabs = Array.prototype.slice.call(root.querySelectorAll('.hm-hl-item'));
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches, cur = 0;
    function visible() { return tabs.filter(function (t) { return !t.parentNode.hidden; }); }
    function fill(i) {
      var h = data[i], q = function (s) { return panel.querySelector(s); };
      q('.hm-hl-img img').src = imgBase + h.image;
      q('.hm-hl-img').href = q('.hm-hl-go').href = base + '#' + h.key;
      q('.hm-hl-venue').textContent = h.venue; q('.hm-hl-track').textContent = h.track;
      q('.hm-hl-rank').textContent = h.rank || ''; q('.hm-hl-rank').hidden = !h.rank;
      q('.hm-hl-title').textContent = h.title; q('.hm-hl-authors').textContent = h.authors;
      q('.hm-hl-where').textContent = h.where; q('.hm-hl-when').textContent = h.when;
      var vis = visible(), pos = vis.indexOf(tabs[i]);
      q('.hm-hl-count').textContent = (pos + 1) + ' / ' + vis.length;
      panel.setAttribute('aria-labelledby', tabs[i].id);
    }
    function select(i, focus) {
      if (i === cur && panel.dataset.ready) { if (focus) tabs[i].focus(); return; }
      tabs.forEach(function (t, k) { var on = k === i; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1; });
      cur = i; panel.dataset.ready = '1';
      if (reduce) fill(i); else { panel.classList.add('is-swapping'); setTimeout(function () { fill(i); panel.classList.remove('is-swapping'); }, 160); }
      if (focus) tabs[i].focus();
      var list = tabs[i].closest('ol'), r = tabs[i].getBoundingClientRect(), lr = list.getBoundingClientRect();
      if (r.top < lr.top || r.bottom > lr.bottom) list.scrollTop += r.top - lr.top - 8;
    }
    function step(d) { var vis = visible(), p = vis.indexOf(tabs[cur]); if (p < 0) p = 0; var n = vis[(p + d + vis.length) % vis.length]; select(tabs.indexOf(n), false); }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(i, false); });
      t.addEventListener('keydown', function (e) {
        var vis = visible(), p = vis.indexOf(t), n = null;
        if (e.key === 'ArrowDown') n = vis[(p + 1) % vis.length];
        else if (e.key === 'ArrowUp') n = vis[(p - 1 + vis.length) % vis.length];
        else if (e.key === 'Home') n = vis[0]; else if (e.key === 'End') n = vis[vis.length - 1];
        if (n) { e.preventDefault(); select(tabs.indexOf(n), true); }
      });
    });
    panel.querySelector('.hm-hl-prev').addEventListener('click', function () { step(-1); });
    panel.querySelector('.hm-hl-next').addEventListener('click', function () { step(1); });
    root.querySelectorAll('.hm-hl-seg button').forEach(function (b) {
      b.addEventListener('click', function () {
        root.querySelectorAll('.hm-hl-seg button').forEach(function (x) { var on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', on); });
        tabs.forEach(function (t) { t.parentNode.hidden = !(b.dataset.k === 'all' || t.parentNode.dataset.k === b.dataset.k); });
        var vis = visible(); panel.dataset.ready = '';
        select(tabs.indexOf(vis.indexOf(tabs[cur]) > -1 ? tabs[cur] : vis[0]), false);
      });
    });
    fill(0); panel.dataset.ready = '1';
  })();

  // ---- News: categorise, give each item a headline, filter, expand
  var tl = root.querySelector('.hm-tl'); if (!tl) return;
  var items = Array.prototype.slice.call(tl.querySelectorAll('.hm-ni'));
  var LABEL = { paper: 'Paper', grant: 'Grant / award', talk: 'Talk / media', service: 'Service', update: 'Update' };
  var RULES = [
    ['update', /joined|appointed|career announcement|faculty advisor|course proposal|new course/],
    ['service', /reviewer|review panel|program committee|guest editor|area chair|session chair|organizing chair|special session|served as|served on|serving as|panelist/],
    ['grant', /grant|award|awarded|funded|fellowship|top 2%|scholarship|honou?red|recogni[sz]ed|nominated/],
    ['talk', /invited talk|keynote|talk|presented|presentation|interview|featured|news feature|demo/],
    ['paper', /accepted|published|paper|journal|transactions|proceedings/]
  ];
  function classify(t) { t = t.toLowerCase(); for (var k = 0; k < RULES.length; k++) if (RULES[k][1].test(t)) return RULES[k][0]; return null; }
  function firstLine(c) {
    var blocks = c.querySelectorAll('p, div, li');
    for (var b = 0; b < blocks.length; b++) {
      var el = blocks[b]; if (el.querySelector('p, div, li')) continue;
      var txt = '';
      for (var n = 0; n < el.childNodes.length; n++) {
        var node = el.childNodes[n];
        if (node.nodeName === 'BR') { if (txt.trim().length >= 12) break; else continue; }
        txt += node.textContent;
      }
      txt = txt.replace(/\s+/g, ' ').trim();
      if (txt.length >= 12) { firstLine.src = { el: el, upto: n }; return txt; }
    }
    firstLine.src = null;
    return (c.textContent || '').replace(/\s+/g, ' ').trim();
  }
  function dropRepeat(c, full, h) {
    var src = firstLine.src; if (!src || h !== full) return;
    var nodes = Array.prototype.slice.call(src.el.childNodes, 0, src.upto);
    nodes.forEach(function (n) { if (n.parentNode) n.parentNode.removeChild(n); });
    while (src.el.firstChild && (src.el.firstChild.nodeName === 'BR' || (src.el.firstChild.nodeType === 3 && !src.el.firstChild.textContent.trim()))) src.el.removeChild(src.el.firstChild);
    if (!src.el.textContent.trim() && !src.el.querySelector('a,img')) src.el.remove();
  }
  function headline(c) {
    var full = firstLine(c).replace(/^[^\w“"(]+/, ''), h = full;
    if (h.length > 160) {
      var cut = h.slice(0, 160).search(/(?<!\b(?:Dr|Mr|Ms|Prof|vs|al|e\.g|i\.e))[.!?](?=\s)[^.!?]*$/);
      h = cut > 40 ? h.slice(0, cut + 1) : h.slice(0, 150).replace(/\s+\S*$/, '') + '…';
    }
    dropRepeat(c, full, h);
    return h;
  }
  var counts = { all: items.length, paper: 0, grant: 0, talk: 0, service: 0 };
  items.forEach(function (it) {
    var c = it.querySelector('.hm-nc'), h = headline(c), cat = classify(h) || classify(c.textContent) || 'update';
    it.dataset.c = cat; if (counts[cat] !== undefined) counts[cat]++;
    var tag = it.querySelector('.hm-ncat'); tag.textContent = LABEL[cat]; tag.dataset.c = cat;
    it.querySelector('.hm-nt').textContent = h;
    var btn = it.querySelector('.hm-nh');
    btn.addEventListener('click', function () {
      var open = it.classList.toggle('is-open'); c.hidden = !open; btn.setAttribute('aria-expanded', open);
    });
  });
  root.querySelectorAll('.hm-nfb').forEach(function (b) { b.querySelector('span').textContent = counts[b.dataset.c] || 0; if (!counts[b.dataset.c]) b.hidden = true; });

  var LIMIT = 8, expanded = false, filter = 'all', more = root.querySelector('.hm-more');
  function render() {
    tl.querySelectorAll('.hm-yr').forEach(function (y) { y.remove(); });
    var match = items.filter(function (it) { return filter === 'all' || it.dataset.c === filter; });
    items.forEach(function (it) { it.hidden = true; });
    var lastYear = null;
    match.forEach(function (it, i) {
      if (!expanded && i >= LIMIT) return;
      it.hidden = false;
      if (it.dataset.year !== lastYear) {
        var y = document.createElement('div'); y.className = 'hm-yr'; y.textContent = it.dataset.year;
        tl.insertBefore(y, it); lastYear = it.dataset.year;
      }
    });
    var rest = match.length - LIMIT;
    more.hidden = rest <= 0;
    more.textContent = expanded ? 'Show fewer updates' : 'Show ' + rest + ' earlier update' + (rest === 1 ? '' : 's');
  }
  root.querySelectorAll('.hm-nfb').forEach(function (b) {
    b.addEventListener('click', function () {
      filter = b.dataset.c; expanded = false;
      root.querySelectorAll('.hm-nfb').forEach(function (x) { var on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', on); });
      render();
    });
  });
  more.addEventListener('click', function () { expanded = !expanded; render(); });
  // open the most recent item so visitors see what an expanded entry looks like
  if (items[0]) items[0].querySelector('.hm-nh').click();
  render();
})();
</script>
